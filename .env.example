# 複製成 .env 後填入。所有可用的設定與預設值見 shared/settings.py，
# 這裡只列最常改的——沒寫的就會用預設值。

# ── 必填（雲端版才需要）────────────────────────────────────────────
# 到 https://aistudio.google.com/apikey 申請
GEMINI_API_KEY=your_api_key_here

# ── 常改的（以下都是預設值，不需要就整行刪掉）──────────────────────
# 生成模型
# GEMINI_CHAT_MODEL=gemini-flash-latest

# llama.cpp server 的位址與逾時
# LLAMA_URL=http://localhost:8080/v1/chat/completions
# LLAMA_TIMEOUT=120

# 一鍵啟動腳本（start.ps1 -Local）要知道 llama.cpp 在哪才開得起來。
# 這三個只有腳本讀，Python 那側不認得——每台機器的路徑都不一樣，所以不寫死
# 在腳本裡。LLAMA_DEVICE 不填就讓 llama.cpp 自己選裝置，而它可能把模型拆一半
# 到內顯上；編號用 llama-server.exe --list-devices 查。
# LLAMA_EXE=C:\path\to\llama-server.exe
# LLAMA_MODEL=C:\path\to\Qwen2.5-3B-Instruct-Q4_K_M.gguf
# LLAMA_DEVICE=Vulkan0

# 一次撈幾個不同職缺、生成溫度
# RETRIEVE_K=5
# TEMPERATURE=0.2

# history 上限（超過就從前面砍，預防爆 context）。用奇數，配對才不會歪。
# 雲端留空 = 不砍，Gemini 的 context 寬裕得多。
# ONPERM_HISTORY_LIMIT=11

# 瀏覽器前端的來源（逗號分隔）。本機的任意埠預設就放行，這裡只有從**別台
# 機器**連進來時才要填——例如 vite 開了 --host，用手機或另一台電腦連的時候。
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.10:5173

# ⚠ min_score 不在這裡，也不該進 .env。
#   它是 tools/probe_threshold.py 對「這個 embedding 模型 ＋ 這批語料」量出來的
#   結果，不是可以隨手調的旋鈕。要臨時試別的值就傳建構子參數：
#       providers.retriever_for("cloud", min_score=0.7)
